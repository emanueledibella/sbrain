# ./scripts/init.sh genera la password e UID/GID senza richiedere Python sul computer.
# Per personalizzare i modelli: copiare questo file in .env PRIMA di eseguire init.sh.
# Non sovrascrivere una .env già usata con il volume Neo4j esistente.
SB_VAULT_PATH=./vault
SB_NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-random-password
SB_NEO4J_DATABASE=neo4j
SB_MCP_PORT=8000
# SB_CONTAINER_UID e SB_CONTAINER_GID sono aggiunti automaticamente da init.sh.
# Compose configura i collegamenti interni bolt://neo4j:7687 e http://ollama:11434.
SB_CHAT_MODEL=qwen2.5:1.5b
SB_EMBEDDING_MODEL=embeddinggemma
SB_EMBEDDING_DIMENSIONS=768
SB_MODEL_TIMEOUT=180
SB_MODEL_THREADS=4
SB_MODEL_CONTEXT=16384
SB_MODEL_OUTPUT_TOKENS=2048
