# ./scripts/init.sh creates the password and UID/GID without requiring Python on the host.
# To customize models, copy this file to .env BEFORE running init.sh.
# Preserve the .env already used with an existing Neo4j volume.
SB_VAULT_PATH=./vault
SB_NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-random-password
SB_NEO4J_DATABASE=neo4j
SB_MCP_PORT=8000
# init.sh automatically adds SB_CONTAINER_UID and SB_CONTAINER_GID.
# Compose configures internal connections to bolt://neo4j:7687 and http://ollama:11434.
SB_CHAT_MODEL=qwen2.5:1.5b
SB_EMBEDDING_MODEL=embeddinggemma
SB_EMBEDDING_DIMENSIONS=768
SB_MODEL_TIMEOUT=180
SB_MODEL_THREADS=4
SB_MODEL_CONTEXT=16384
SB_MODEL_OUTPUT_TOKENS=2048

# init.sh generates distinct owner and read-only bearer credentials.
SB_MCP_WRITE_TOKEN=replace-with-a-random-token
SB_MCP_READ_TOKEN=replace-with-a-random-token
SB_MCP_REQUESTS_PER_MINUTE=120
SB_MCP_MAX_INFLIGHT=8
SB_MCP_MAX_BODY_BYTES=2097152
